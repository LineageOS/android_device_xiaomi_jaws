<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Reads the stock firmware's IR database from USB drives -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_remote"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteButtons">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Stock Xiaomi firmware action, so existing shortcuts keep working. -->
            <intent-filter>
                <action android:name="mitv.setup.ACTION_REMOTE_BUTTON_SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Database choice from the TV Settings page -->
        <receiver
            android:name=".settings.DatabaseChoiceReceiver"
            android:exported="false" />

        <!-- TV Settings > Remotes & Accessories > Set up remote buttons -->
        <provider
            android:name=".settings.IrSliceProvider"
            android:authorities="@string/slice_authority"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.app.slice.category.SLICE" />
            </intent-filter>
        </provider>
    </application>
</manifest>
