# Mount context of the tmpfs holding the decrypted Dolby MS12 library, as on stock. The library
# is written at boot and then loaded by the decoders, which no file_type or fs_type may allow, so
# this type carries no attributes.
type dolby_ms12_tmpfs;
allow dolby_ms12_tmpfs self:filesystem associate;

type dolby_ms12_mnt_file, file_type, vendor_file_type;
