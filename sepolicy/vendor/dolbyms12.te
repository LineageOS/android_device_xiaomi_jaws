type dolbyms12, domain;
type dolbyms12_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(dolbyms12)

# Decrypts /oem/lib/ms12/libdolbyms12.so through /dev/dolby_fw
r_dir_file(dolbyms12, oemfs)
allow dolbyms12 dolby_fw_device:chr_file rw_file_perms;

# into the tmpfs that init.jaws.dolby.rc mounts on /vendor/lib/ms12
allow dolbyms12 dolby_ms12_tmpfs:dir { search getattr open read write add_name };
allow dolbyms12 dolby_ms12_tmpfs:file { create open getattr read write setattr };
