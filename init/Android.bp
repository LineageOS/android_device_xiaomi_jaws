prebuilt_etc {
    name: "init.jaws.bluetooth.rc",
    src: "init.jaws.bluetooth.rc",
    sub_dir: "init",
    device_specific: true,
}

prebuilt_etc {
    name: "init.jaws.usb.rc",
    src: "init.jaws.usb.rc",
    sub_dir: "init",
    device_specific: true,
}

prebuilt_etc {
    name: "init.recovery.jaws.rc",
    src: "init.recovery.jaws.rc",
    sub_dir: "init",
    recovery: true,
}
