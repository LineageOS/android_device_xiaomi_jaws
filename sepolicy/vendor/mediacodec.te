# Dolby MS12, for the Codec2 Dolby decoders
allow mediacodec dolby_ms12_tmpfs:filesystem getattr;
allow mediacodec dolby_ms12_tmpfs:dir search;
allow mediacodec dolby_ms12_tmpfs:file { open getattr read map execute };
allow mediacodec dolby_fw_device:chr_file r_file_perms;
allow mediacodec audio_utils_device:chr_file rw_file_perms;

# MS12 reads media.libplayer.dtsopt0, a legacy Amlogic player option that is never set
dontaudit mediacodec default_prop:file r_file_perms;
